{
    "configurations": [
        {
            "name": "Linux",
            "includePath": [
                "${workspaceFolder}/**",
                "/usr/include/python3.13",      // 🔥 Python headers
                "/usr/include/python3.13",      // Альтернатива (python3.12m)
                "/usr/include/**",               // Системные headers
                "/usr/local/include/**"
            ],
            "defines": [
                "_DEBUG",
                "UNICODE",
                "_UNICODE"
            ],
            "compilerPath": "/usr/bin/g++",
            "cStandard": "c17",
            "cppStandard": "c++17",
            "intelliSenseMode": "linux-gcc-x64",
            "browse": {
                "path": [
                    "${workspaceFolder}/**",
                    "/usr/include/python3.13"
                ],
                "limitSymbolsToIncludedHeaders": true
            },
            "compilerArgs": [
                "-fPIC"
            ]
        }
    ],
    "version": 4
}